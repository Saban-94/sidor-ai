rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'hsaban2025@gmail.com'
      ); 
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // --- Collection Schemas ---
    
    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() <= 200 &&
             data.items is string && data.items.size() <= 5000;
    }

    function isValidReminder(data) {
      return data.userId == request.auth.uid &&
             data.text is string && data.text.size() <= 1000;
    }

    function isValidMessage(data) {
      return data.senderId is string && data.senderId.size() <= 128 &&
             data.text is string && data.text.size() <= 2000;
    }

    function isValidProfile(data) {
      return data.id is string &&
             data.name is string && data.name.size() <= 100 &&
             data.role is string && data.role.size() <= 100;
    }

    // --- Match Rules ---

    // 0. Admin Bypass
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // 1. User Profiles
    match /user_magic_pages/{userId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin() && isValidProfile(incoming()));
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isOwner(userId) && (
          (isValidProfile(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['id', 'name', 'role', 'phone', 'email', 'avatarUrl', 'updatedAt', 'lastSeen', 'imageUrl', 'fileUrl', 'avatar'])) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['lastSeen']))
        ))
      );
      allow delete: if isAdmin() || isOwner(userId);
    }

    // 2. Orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isSignedIn() && (isAdmin() || isValidOrder(incoming()));
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isValidOrder(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['id', 'customerName', 'items', 'status', 'destination', 'orderNumber', 'updatedAt', 'driverId', 'eta', 'deliveryNoteUrl', 'avatarUrl', 'imageUrl', 'fileUrl', 'avatar', 'customerId', 'customerPhone', 'date', 'time', 'warehouse', 'totalAmount', 'documentIds', 'trackingId', 'createdBy', 'signature', 'base64Data'])
        )) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['avatarUrl', 'imageUrl', 'fileUrl', 'avatar']))
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().createdBy == request.auth.uid);
    }

    // 3. Reminders
    match /reminders/{reminderId} {
      allow read, list: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      allow create: if isSignedIn() && (isAdmin() || (incoming().userId == request.auth.uid && isValidReminder(incoming())));
      allow update: if isSignedIn() && (isAdmin() || (existing().userId == request.auth.uid && (
          incoming().diff(existing()).affectedKeys().hasOnly(['text', 'dueDate', 'dueTime', 'isCompleted', 'isNagging', 'updatedAt', 'userId', 'title', 'description', 'priority', 'snoozeCount', 'ringtone', 'createdAt', 'orderId'])
      )));
      allow delete: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
    }

    // 4. Office Messages
    match /office_messages/{messageId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && isValidMessage(incoming());
      allow update: if isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['avatarUrl', 'imageUrl', 'fileUrl', 'avatar']));
      allow delete: if isAdmin();
    }

    // 5. Inventory, Drivers, Customers, Sales, Smart Locations
    match /inventory/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /drivers/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /customers/{id} { allow read, list: if isSignedIn(); allow write: if isSignedIn(); }
    match /sales/{id} { allow read, list: if isSignedIn(); allow write: if isSignedIn(); }
    match /smart_locations/{id} { allow read, list: if isSignedIn(); allow write: if isSignedIn(); }
    match /morning_reports/{id} { allow read, list: if true; allow write: if isSignedIn(); }
    match /system_notifications/{id} { allow read, list: if isSignedIn(); allow create: if isSignedIn(); allow update, delete: if isAdmin(); }
    
    // 6. Private Messages
    match /users/{userId}/messages/{messageId} {
      allow read, list: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin() || incoming().senderId == request.auth.uid);
      allow update, delete: if isOwner(userId) || isAdmin();
    }
  }
}

